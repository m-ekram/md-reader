{
  "name": "ekram-md",
  "version": "0.1.0",
  "description": "A fast WYSIWYG markdown editor for Windows",
  "productName": "ekram.md",
  "main": "./out/main/index.js",
  "author": "ekram",
  "license": "MIT",
  "private": true,
  "scripts": {
    "bench": "node scripts/bench.cjs",
    "build": "electron-vite build",
    "build:dir": "electron-vite build && electron-builder --win --dir",
    "build:win": "electron-vite build && electron-builder --win",
    "dev": "electron-vite dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spike:roundtrip": "vitest run --project unit spike/",
    "start": "electron-vite preview",
    "test": "vitest run --project unit",
    "test:e2e": "electron-vite build && vitest run --project e2e",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.0",
    "globals": "16.5.0",
    "happy-dom": "^20.14.5",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.3.6",
    "vitest": "^5.0.1",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "chokidar": "5.0.0",
    "dompurify": "3.4.15",
    "mermaid": "12.0.0",
    "prosemirror-search": "1.1.1",
    "remark-frontmatter": "5.0.0",
    "vue": "3.5.43",
    "yaml": "2.9.1"
  }
}
